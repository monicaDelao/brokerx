@startuml
' Titre du diagramme
title Architecture Monolithique BrokerX - Fondations pour UC-01, UC-02, UC-05

' Apparence du diagramme (optionnel, pour un meilleur rendu)
skinparam componentStyle uml2
skinparam linetype ortho

' --- Architecture Monolithique en Couches ---
package "Monolithe BrokerX - Spring Boot" {

  ' --- Couche Présentation ---
  package "Presentation Layer" {
    [WebController] as Controller
    [Thymeleaf Templates] as Views
    note bottom of Controller
      Point d'entrée HTTP pour tous les UC.
      Gestion des formulaires, validation côté client.
      Orchestration des appels vers la couche service.
    end note
  }

  ' --- Couche Services (Logique Applicative) ---
  package "Application Services Layer" {
    [ClientService] as ClientSvc
    [MfaService] as MfaSvc  
    [OrdreService] as OrdreSvc
    [SecurityService] as SecuritySvc
    
    note bottom of ClientSvc
      UC-01: Inscription et vérification identité
      Orchestration des validations métier
    end note
    
    note bottom of MfaSvc
      UC-02: Authentification multi-facteurs
      Génération/validation codes OTP
    end note
    
    note bottom of OrdreSvc
      UC-05: Logique de placement d'ordres
      Contrôles pré-trade, validation métier
    end note
  }

  ' --- Couche Domaine (Coeur Métier) ---
  package "Domain Layer" {
    [Domain Entities] as Entities
    [Business Rules] as Rules
    
    note bottom of Entities
      Client, Ordre, CompteDeCourtage, MfaConfig
      Représentation pure du métier
    end note
    
    note bottom of Rules
      Règles métier encapsulées
      Validation des données, contraintes
    end note
  }

  ' --- Couche Persistance ---
  package "Data Access Layer" {
    [Spring Data Repositories] as Repositories
    [JPA Entities] as JPAEntities
    
    note bottom of Repositories
      Abstraction de la persistance
      ClientRepository, OrdreRepository, etc.
    end note
  }

}

' --- Définition des composants externes ---
database "Base de Données" as DB
component "Email/SMS Gateway" as Gateway
component "Moteur d'Appariement" as Engine

' --- Relations (Dépendances) entre les couches ---

' Flux descendant : Presentation -> Application -> Domain -> Data
Controller ..> ClientSvc : @Autowired
Controller ..> MfaSvc : @Autowired  
Controller ..> OrdreSvc : @Autowired
Controller ..> Views : render

ClientSvc ..> Entities : manipule
MfaSvc ..> Entities : manipule
OrdreSvc ..> Entities : manipule
SecuritySvc ..> Rules : applique

ClientSvc ..> Repositories : utilise
MfaSvc ..> Repositories : utilise
OrdreSvc ..> Repositories : utilise

Repositories ..> JPAEntities : mappe
Repositories ..> DB : @Repository

' Intégrations externes
ClientSvc ..> Gateway : notifications
MfaSvc ..> Gateway : codes OTP
OrdreSvc ..> Engine : soumission ordres

note bottom of Gateway
  Simulation d'envoi email/SMS
  pour UC-01 et UC-02
end note

note bottom of Engine  
  Moteur d'appariement pour UC-05
  (préparé pour évolution future)
end note

@enduml