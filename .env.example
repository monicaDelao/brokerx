# Configuration d'environnement pour BrokerX
# Copiez ce fichier vers .env et modifiez selon vos besoins

# ========================================
# CONFIGURATION PAR DÉFAUT (DÉVELOPPEMENT)
# ========================================
# Base de données H2 embarquée - Simple et rapide
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/brokerx;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE
SPRING_DATASOURCE_USERNAME=brokerx
SPRING_DATASOURCE_PASSWORD=brokerx
SPRING_H2_CONSOLE_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Version de l'application
BROKERX_VERSION=latest

# ========================================
# CONFIGURATION PRODUCTION (OPTIONNELLE)
# ========================================
# Décommentez et configurez pour utiliser MySQL en production
# avec: docker-compose --profile production up

# Base de données MySQL
# SPRING_PROFILES_ACTIVE=production
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/brokerx_db
# SPRING_DATASOURCE_USERNAME=brokerx_user
# SPRING_DATASOURCE_PASSWORD=VOTRE_MOT_DE_PASSE_SECURISE
# SPRING_H2_CONSOLE_ENABLED=false

# Configuration MySQL
# MYSQL_ROOT_PASSWORD=VOTRE_MOT_DE_PASSE_ROOT
# MYSQL_DATABASE=brokerx_db
# MYSQL_USER=brokerx_user
# MYSQL_PASSWORD=VOTRE_MOT_DE_PASSE_SECURISE

# ========================================
# USAGE
# ========================================
# Développement (H2):     docker-compose up brokerx-web
# Production (MySQL):     docker-compose --profile production up